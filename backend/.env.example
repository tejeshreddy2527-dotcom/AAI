# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Configuration
PORT=5000
CORS_ORIGIN=*

# Google Gemini LLM API
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase Database Configuration
# Obtain from: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Direct PostgreSQL Connection (for running migrations)
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
